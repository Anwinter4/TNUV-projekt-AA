<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ARTLY" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="materialAlertDialogTheme">@style/CustomAlertDialog</item>
    </style>

    <!-- Stil za tvoj popup -->
    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Eksplicitno nastavljena barva ozadja -->
        <item name="colorSurface">#F5C7D4</item>
        <item name="android:background">#F5C7D4</item>
        <item name="backgroundTint">#F5C7D4</item>

        <!-- Zaobljeni robovi -->
        <item name="shapeAppearanceOverlay">@style/CustomDialogShape</item>

        <!-- Barve besedila in ikon na površini -->
        <item name="colorOnSurface">#C06084</item>
        <item name="colorPrimary">#C06084</item>

        <!-- Stil za ODEBELJEN NASLOV s fiksno velikostjo -->
        <item name="materialAlertDialogTitleTextStyle">@style/CustomDialogTitle</item>

        <!-- Stil za gumba znotraj popup-a (Filled) -->
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDialogButton</item>
    </style>

    <!-- Stil za naslov s fiksno velikostjo -->
    <style name="CustomDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#C06084</item>
        <item name="android:textSize">20sp</item> <!-- Fiksna velikost za vse dialoge -->
    </style>

    <!-- Definicija zaobljenih robov -->
    <style name="CustomDialogShape" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Stil za FILLED gumbe z belim besedilom -->
    <style name="CustomDialogButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#C06084</item> <!-- Temnejša roza za gumb -->
        <item name="android:layout_margin">4dp</item>
        <item name="shapeAppearanceOverlay">@style/CustomDialogShape</item>
    </style>





    <style name="Theme.ARTLY" parent="Base.Theme.ARTLY" />
</resources>